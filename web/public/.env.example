# Public configuration returned by GET /api/activity
DISCORD_CLIENT_ID=
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only Vercel environment variables; never expose these to the browser
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Optional defense in depth for production. Copy the application's Ed25519
# public key from Discord, then set the requirement to true only after proxy
# authentication is enabled and verified in the Developer Portal.
DISCORD_REQUIRE_PROXY_AUTH=false
DISCORD_PUBLIC_KEY=

# ES256 private JWK imported into Supabase JWT Signing Keys. Keep it one-line JSON.
SUPABASE_JWT_PRIVATE_KEY={"kty":"EC","kid":"REPLACE_ME","crv":"P-256","x":"...","y":"...","d":"..."}
SUPABASE_JWT_KEY_ID=REPLACE_ME

# At least 32 random bytes; signs sessions and hashes Discord IDs into opaque state keys.
ACTIVITY_STATE_SECRET=
