# Optional CI/advanced overrides. The guided launcher reads public identity from
# Unreal and discovers Supabase API keys in memory, so it needs no env file.
# Public configuration returned by GET /api/activity
DISCORD_CLIENT_ID=
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Optional social-discovery adapter. Enables the rpc.activities.write scope used
# by the Discord Activity Set Rich Presence Blueprint node.
DISCORD_ENABLE_RICH_PRESENCE=false

# Server-only Vercel environment variables; never expose these to the browser.
# The guided launcher discovers SUPABASE_SECRET_KEY through the authenticated CLI,
# prompts for other missing values on --apply, and never updates this file.
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Optional defense in depth for production. Copy the application's Ed25519
# public key from Discord, then set the requirement to true only after proxy
# authentication is enabled and verified in the Developer Portal.
DISCORD_REQUIRE_PROXY_AUTH=false
DISCORD_PUBLIC_KEY=

# Optional private Broadcast/Presence. Basic Discord auth and server-mediated
# persistence work without these. If enabled, generate the ES256 JWK yourself,
# import/activate the same key in Supabase, and keep the private JSON one-line.
# SUPABASE_JWT_PRIVATE_KEY={"kty":"EC","kid":"REPLACE_ME","crv":"P-256","x":"...","y":"...","d":"..."}
# SUPABASE_JWT_KEY_ID=REPLACE_ME

# At least 32 random bytes; signs sessions and hashes Discord IDs into opaque state keys.
# The release tool generates this in memory with --vercel-only-secrets.
ACTIVITY_STATE_SECRET=
