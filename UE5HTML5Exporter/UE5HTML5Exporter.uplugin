{
  "FileVersion": 3,
  "Version": 57,
  "VersionName": "0.3.58",
  "FriendlyName": "UE5 to HTML5 Exporter",
  "Description": "Exports an Unreal Engine level and a supported subset of Blueprint gameplay to a ready-to-host WebGL game.",
  "Category": "Importers & Exporters",
