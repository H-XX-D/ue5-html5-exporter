  "CanContainContent": false,
  "IsBetaVersion": true,
  "Installed": false,
  "Modules": [
    {
      "Name": "UE5HTML5ExporterRuntime",
      "Type": "Runtime",
      "LoadingPhase": "Default"
    },
    {
      "Name": "UE5HTML5Exporter",
      "Type": "Editor",
      "LoadingPhase": "Default"
    }
  ],
  "Plugins": [
    { "Name": "GLTFExporter", "Enabled": true },
    { "Name": "EnhancedInput", "Enabled": true }
  ]
}
